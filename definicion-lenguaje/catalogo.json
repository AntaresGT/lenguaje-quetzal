    },
    {
      "id": "api-sistema-archivos",
      "nombre": "sistema_archivos",
      "categoría": "stdlib",
      "objetivo": "FS tipado con permisos: archivos, Bits, Flujo, Observador.",
      "funciones": ["sync/async _asincrono", "lectura/escritura/todo", "cursor Flujo", "watch Observador"],
      "api": [
        "SistemaArchivos.leer", "escribir", "anexar", "abrir_flujo", "observar",
        "crear_directorio", "crear_directorios", "listar_*", "existe", "abrir", "borrar", "copiar", "mover", "renombrar",
