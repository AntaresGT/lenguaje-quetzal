    {
      "id": "api-matematica",
      "nombre": "Matemática",
      "categoría": "stdlib",
      "objetivo": "Constantes y funciones matemáticas.",
      "funciones": ["aritmética", "trigo", "logs", "redondeo", "estadística", "aleatorios"],
      "api": [
        "PI", "TAU", "E",
        "sumar", "restar", "multiplicar", "dividir", "potencia", "absoluto",
        "seno", "coseno", "tangente", "grados_a_radianes", "radianes_a_grados", "hipotenusa",
        "logaritmo", "logaritmo_base", "exponencial", "raiz_cuadrada",
        "redondear", "piso", "techo",
        "promedio", "maximo", "minimo", "suma_total", "producto_total",
        "aleatorio", "aleatorio_rango"
      ],
      "doc": "modulos-nativos.md#matematica",
      "import": "importar { Matemática } desde \"quetzal/matemática\""
    },
    {
      "id": "api-tiempo",
      "nombre": "Tiempo",
      "categoría": "stdlib",
      "objetivo": "Fechas, horas, zonas y aritmética temporal.",
      "funciones": ["constructores", "componentes", "formateo", "comparación", "zonas"],
      "api": [
        "ahora", "ahora_utc", "ahora_en", "hoy", "marca", "desde_marca", "analizar",
