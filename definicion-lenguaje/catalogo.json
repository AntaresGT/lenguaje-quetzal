        "año", "mes", "dia", "hora", "minuto", "segundo", "milisegundo",
        "dia_semana", "dia_año", "texto", "texto_fecha", "texto_hora", "formatear",
        "agregar_años", "agregar_meses", "agregar_dias", "agregar_horas", "agregar_minutos", "agregar_segundos",
        "diferencia", "es_antes", "es_despues", "es_mismo_instante", "es_mismo_dia",
        "zona", "desfase", "en_zona", "en_utc", "en_local"
      ],
      "doc": "modulos-nativos.md#tiempo",
      "import": "importar { Tiempo } desde \"quetzal/tiempo\""
    },
    {
      "id": "api-motor",
      "nombre": "ExpresiónRegular",
      "categoría": "stdlib",
      "objetivo": "Regex inmutables con banderas por copia.",
      "funciones": ["match", "buscar", "reemplazar", "dividir", "fábricas", "flags"],
      "api": [
        "escapar", "nueva_desde_comodín", "nueva_solo_dígitos", "nueva_solo_letras", "nueva_correo", "nueva_url", "nueva_ipv4",
