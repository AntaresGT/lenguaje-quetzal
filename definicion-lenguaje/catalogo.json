{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://lenguaje-quetzal/catalogo.json",
  "title": "Catálogo canónico de Lenguaje Quetzal",
  "description": "Inventario machine-readable de identidad, pipeline y características.",
  "version_especificación": "1.0.0",
  "versión_lenguaje_documentada": "0.0.2",
  "idioma": "es",
  "extensión_fuente": ".qz",
  "manifiesto_proyecto": "quetzal.json",

  "identidad": {
    "nombre": "Lenguaje Quetzal",
    "nombre_corto": "Quetzal",
    "tipo": "lenguaje de programación interpretado de propósito general",
    "implementación": "intérprete en Rust",
    "misión": "Programación en español natural, funcional para aplicaciones reales (no solo enseñanza).",
    "propiedades": [
      "keywords y API en español",
      "tipado estático y explícito (sin inferencia)",
      "inmutable por defecto; var introduce mutabilidad",
      "POO clásica: objeto, prototipo, herencia, libre",
      "asincronía: asincrono / esperar",
      "excepciones: intentar / capturar / finalmente / lanzar",
      "módulos: importar / exportar / desde / como",
      "interpolación: t\"...{expr}...\"",
      "permisos declarativos en quetzal.json (red, sistema-archivos, ejecución)",
      "lexer normaliza tildes en keywords e identificadores"
    ],
    "no_soporta": [
      "funciones anónimas / lambdas",
      "inferencia de tipos",
      "comentarios de bloque /* */",
      "import * / import default / import dinámico",
      "operador ** (usar Matemática.potencia)"
    ]
  },

  "pipeline": {
    "descripción": "Flujo de un programa .qz desde fuente hasta ejecución",
    "nodos": [
      { "id": "fuente", "label": "Fuente .qz + quetzal.json", "artefacto": "texto UTF-8" },
      { "id": "lexer", "label": "Análisis léxico", "artefacto": "Vec<Token>", "crate": "lexico" },
      { "id": "parser", "label": "Análisis sintáctico", "artefacto": "AST", "crate": "sintaxis" },
      { "id": "semántica", "label": "Tipos / resolución / permisos", "artefacto": "AST tipado + grafo módulos" },
      { "id": "cargador", "label": "Carga de módulos", "artefacto": "programa enlazado", "crate": "motor" },
      { "id": "evaluador", "label": "Evaluación / runtime", "artefacto": "valores + efectos", "crate": "motor" },
      { "id": "stdlib", "label": "API nativa", "artefacto": "consola, matemática, tiempo, motor, sistema_archivos, red" }
    ],
    "aristas": [
      { "from": "fuente", "to": "lexer", "label": "caracteres" },
      { "from": "lexer", "to": "parser", "label": "tokens" },
      { "from": "parser", "to": "semántica", "label": "AST" },
      { "from": "semántica", "to": "cargador", "label": "imports resueltos" },
      { "from": "cargador", "to": "evaluador", "label": "entrada" },
      { "from": "evaluador", "to": "stdlib", "label": "llamadas nativas" },
      { "from": "stdlib", "to": "evaluador", "label": "valores / excepciones" }
    ]
  },

  "características": [
    {
      "id": "tipo-entero",
      "nombre": "tipo entero",
      "categoría": "tipos",
      "objetivo": "Enteros con signo de 64 bits (i64) para conteos, índices y aritmética exacta.",
      "funciones": ["declaración tipada", "literales enteros", "ops aritméticas/comparación", "nulo polimórfico"],
      "api": ["texto()", "logico()", "absoluto()", "entero()", "numero()", "número()"],
      "doc": "tipos.md#tipo-entero",
      "keywords": ["entero"]
    },
    {
      "id": "tipo-numero",
      "nombre": "tipo número",
      "categoría": "tipos",
      "objetivo": "Decimales IEEE 754 double para cálculo real.",
      "funciones": ["literales decimales", "ops aritméticas", "conversión a/desde texto"],
      "api": ["texto()", "logico()", "absoluto()", "entero()", "numero()", "número()"],
      "doc": "tipos.md#tipo-numero",
      "keywords": ["número", "numero"]
    },
    {
      "id": "tipo-texto",
      "nombre": "tipo texto",
      "categoría": "tipos",
      "objetivo": "Cadenas Unicode UTF-8; interpolación con t\"...\".",
      "funciones": ["literales \"...\"", "templates t\"{expr}\"", "concatenación +", "índice [i] / [-1]"],
      "api": [
        "longitud()", "esta_vacia()", "mayusculas()", "minusculas()", "capitalizar()", "titulo()",
        "recortar()", "recortar_inicio()", "recortar_final()",
        "contiene(texto)", "empieza_con(texto)", "termina_con(texto)", "encontrar(texto)", "buscar_ultimo(texto)", "contar(texto)",
        "reemplazar(viejo, nuevo)", "reemplazar_primero(viejo, nuevo)",
        "dividir(separador)", "partir_lineas()",
        "subtexto(inicio, fin)", "izquierda(n)", "derecha(n)",
        "repetir(n)", "invertir()",
        "es_numero()", "es_entero()", "es_alfanumerico()", "igual_sin_caso(texto)",
        "a_base64()", "decodificar_base64()", "a_enlace()", "decodificar_enlace()",
        "entero()", "numero()", "número()", "logico()", "texto()", "lista()", "jsn()"
      ],
      "doc": "tipos.md#tipo-texto",
      "keywords": ["texto"]
    },
    {
      "id": "tipo-log",
      "nombre": "tipo log",
      "categoría": "tipos",
      "objetivo": "Booleanos con literales verdadero / falso.",
      "funciones": ["ops lógicas && || !", "condiciones si/mientras/para"],
      "api": ["texto()"],
      "doc": "tipos.md#tipo-log",
      "keywords": ["log", "verdadero", "falso"]
    },
    {
      "id": "tipo-vacio",
      "nombre": "tipo vacío",
      "categoría": "tipos",
      "objetivo": "Tipo unitario para funciones sin valor de retorno.",
      "funciones": ["anotación de retorno", "retornar sin expresión"],
      "api": [],
      "doc": "tipos.md#tipo-vacio",
      "keywords": ["vacío", "vacio"]
    },
    {
      "id": "tipo-lista",
      "nombre": "tipo lista",
      "categoría": "tipos",
      "objetivo": "Arreglos ordenados; genérico opcional lista<T> o heterogéneos.",
      "funciones": ["literales []", "índice [i]", "iteración para…en/cada", "mutación si var"],
      "api": [
        "longitud()", "esta_vacia()", "primero()", "ultimo()",
        "agregar(elem)", "insertar(pos, elem)", "remover(elem)", "quitar_en(pos)", "limpiar()",
        "contiene(elem)", "buscar(elem)", "buscar_ultimo(elem)", "contar(elem)",
        "ordenar()", "ordenar_descendente()", "ordenado()", "invertir()",
        "tomar(n)", "saltar(n)", "sublista(inicio, fin)",
        "concatenar(otra)", "extender(otra)",
        "sumar()", "promedio()", "maximo()", "minimo()",
        "unir(separador)", "texto()", "json()", "logico()"
      ],
      "doc": "tipos.md#tipo-lista",
      "keywords": ["lista"],
      "global": ["rango(inicio, fin)"]
    },
    {
      "id": "tipo-jsn",
      "nombre": "tipo jsn",
      "categoría": "tipos",
      "objetivo": "Objetos JSON nativos con claves id o cadena.",
      "funciones": ["literales { k: v }", "acceso .clave / [\"clave\"]"],
      "api": [
        "contiene_clave(clave)", "claves()", "valores()",
        "establecer(clave, valor)", "eliminar(clave)", "fusionar(otro)",
        "texto()", "texto_formateado()", "jsn()"
      ],
      "doc": "tipos.md#tipo-jsn",
      "keywords": ["jsn"]
    },
    {
      "id": "tipo-funcion",
      "nombre": "tipo funcion",
      "categoría": "tipos",
      "objetivo": "Referencias a funciones de primera clase (callbacks nombrados).",
      "funciones": ["pasar nombre de función", "métodos libre y enlazados", "sin lambdas"],
      "api": [],
      "doc": "funciones.md#callbacks",
      "keywords": ["funcion"]
    },
    {
      "id": "nulo",
      "nombre": "valor nulo",
      "categoría": "tipos",
      "objetivo": "Ausencia polimórfica asignable a cualquier tipo.",
      "funciones": ["asignación a cualquier tipo", "comparación"],
      "api": [],
      "doc": "tipos.md#nulo",
      "keywords": ["nulo"]
    },
    {
      "id": "mutabilidad",
      "nombre": "mutabilidad var",
      "categoría": "declaraciones",
      "objetivo": "Inmutable por defecto; var tras el tipo habilita reasignación.",
      "funciones": ["tipo [var] nombre = expr", "parámetros var"],
      "api": [],
      "doc": "tipos.md#mutabilidad",
      "keywords": ["var"]
    },
    {
      "id": "control-si",
      "nombre": "condicional si",
      "categoría": "control-flujo",
      "objetivo": "Ramificación condicional con bloques obligatorios.",
      "funciones": ["si (cond) {}", "sino si", "sino", "ternario ?: "],
      "api": [],
      "doc": "control-flujo.md#condicionales",
      "keywords": ["si", "sino"]
    },
    {
      "id": "control-bucles",
      "nombre": "bucles",
      "categoría": "control-flujo",
      "objetivo": "Repetición: mientras, hacer-mientras, para C-style, para-en/cada.",
      "funciones": ["mientras", "hacer…mientras", "para(init;cond;paso)", "para (T var x en|cada coll)", "romper", "continuar"],
      "api": [],
      "doc": "control-flujo.md#bucles",
      "keywords": ["mientras", "hacer", "para", "en", "cada", "romper", "continuar"]
    },
    {
      "id": "excepciones",
      "nombre": "excepciones",
      "categoría": "control-flujo",
      "objetivo": "Errores capturables con pila de llamadas.",
      "funciones": ["intentar", "capturar (excepcion e)", "finalmente", "lanzar expr"],
      "api": ["e.mensaje", "e.llamadas"],
      "doc": "control-flujo.md#excepciones",
      "keywords": ["intentar", "capturar", "finalmente", "lanzar", "excepcion", "excepción"]
    },
    {
      "id": "funciones",
      "nombre": "funciones",
      "categoría": "funciones",
      "objetivo": "Procedimientos tipados con retorno explícito; opc. asíncronos.",
      "funciones": ["[asincrono] tipo nombre(params) {}", "retornar", "recursión", "esperar"],
      "api": [],
      "doc": "funciones.md",
      "keywords": ["retornar", "asincrono", "asincróno", "esperar", "funcion"]
    },
    {
      "id": "poo-objeto",
      "nombre": "objeto",
      "categoría": "poo",
      "objetivo": "Clases con visibilidad, herencia e interfaces.",
      "funciones": ["objeto", "hereda", "como", "implementa", "nuevo", "esto", "padre", "publico/privado", "libre", "constructor = nombre clase"],
      "api": [],
      "doc": "poo.md",
      "keywords": ["objeto", "hereda", "implementa", "como", "nuevo", "esto", "padre", "publico", "público", "privado", "libre"]
    },
    {
      "id": "poo-prototipo",
      "nombre": "prototipo",
      "categoría": "poo",
      "objetivo": "Interfaces con firmas; miembros opcional.",
      "funciones": ["prototipo", "opcional", "implementa"],
      "api": [],
      "doc": "poo.md#prototipo",
      "keywords": ["prototipo", "opcional"]
    },
    {
      "id": "modulos",
      "nombre": "módulos",
      "categoría": "modulos",
      "objetivo": "Partición de código con import/export nombrados.",
      "funciones": ["importar { … } desde \"ruta\"", "exportar { … }", "alias como", "rutas ./ y quetzal/"],
      "api": [],
      "doc": "modulos.md",
      "keywords": ["importar", "exportar", "desde", "como"]
    },
    {
      "id": "api-consola",
      "nombre": "consola",
      "categoría": "stdlib",
      "objetivo": "E/S de terminal global (sin import).",
      "funciones": ["salida colorizada", "entrada con/sin eco"],
      "api": [
        "consola.mostrar(texto)",
        "consola.mostrar_error(texto)",
        "consola.mostrar_advertencia(texto)",
        "consola.mostrar_exito(texto)",
        "consola.mostrar_informacion(texto)",
        "consola.pedir(texto)",
        "consola.pedir_secreto(texto)"
