  "documentos": {
    "README.md": "Índice humano + grafo pipeline + catálogo",
    "identidad.md": "Qué es Quetzal (nunca perder)",
    "catalogo.json": "Este archivo — inventario machine-readable",
    "arquitectura.md": "Arquitectura del intérprete: crates, capas, pipeline VM",
    "gramatica.ebnf.md": "Gramática formal EBNF",
    "gramatica.json": "Gramática JSON para IA/parsers",
    "diagramas.md": "Railroad Mermaid + grafo de flujo",
    "tokens.md": "Léxico",
    "tipos.md": "Tipos y mutabilidad",
    "control-flujo.md": "Control e excepciones",
    "funciones.md": "Funciones y callbacks",
    "poo.md": "Objetos y prototipos",
    "modulos.md": "Import/export",
    "metodos-nativos.md": "API por tipo",
    "modulos-nativos.md": "Biblioteca estándar",
    "manifiesto.md": "quetzal.json",
    "esquema_quetzal.json": "JSON Schema manifiesto",
    "anomalias.md": "Inconsistencias conocidas"
  },

  "consumo": {
    "humano": "Empezar por identidad.md → README → tipos → diagramas",
    "ia": "Cargar catalogo.json + gramatica.json + esquema_quetzal.json; usar docs .md como detalle",
    "máquina": "Validar quetzal.json con esquema_quetzal.json; parsear con gramatica.json / EBNF"
  }
}
