// Controles de flujo

entero edad = 41

// Condicionales
si (edad > 60) {
    consola.imprimir("La persona es de la tercera edad")
} sino si (edad > 18) {
    consola.imprimir("La persona es mayor de edad")
} sino {
    consola.imprimir("La persona es menor de edad")
}

// Palabra reservada 'continuar', continua con la siguiente iteración del ciclo
para (entero var i = 0; i < 10; i++) {
    si (i % 2 == 0) {
        // Si el número es par, se salta la impresión y se continua con la siguiente iteración
        continuar
    }
    consola.imprimir(i)
}