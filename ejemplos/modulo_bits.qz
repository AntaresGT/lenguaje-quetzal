// Módulo nativo quetzal/bits — el objeto Bits
//
// Un Bits es un búfer mutable de bytes (enteros entre 0 y 255). Sustituye a
// lista<entero> para trabajar datos binarios: contenido de archivos,
// cabeceras de formatos, máscaras, operaciones bit a bit, etc.
// No requiere permisos en quetzal.json: nunca toca el sistema.
//
// Importación:
//   importar { Bits } desde "quetzal/bits"
//
// ── Constructores: nuevo Bits(...) ───────────────────────────────────────
//   nuevo Bits()              -> búfer vacío
//   nuevo Bits(tamaño)        -> n bytes inicializados en cero
//   nuevo Bits(texto)         -> los bytes UTF-8 del texto
//   nuevo Bits(lista<entero>) -> copia de la lista (valores 0-255)
//
// ── Funciones libres ─────────────────────────────────────────────────────
//   Bits.desde_hex(texto) -> Bits — "4f4b" o "4f 4b"; E0406 si es inválido
//
// ── Métodos de consulta ──────────────────────────────────────────────────
//   .longitud()           -> entero — cantidad de bytes
//   .obtener(indice)      -> entero — acepta negativos desde el final
//   .rebanada(inicio,fin) -> Bits   — sub-búfer [inicio, fin)
//   .a_texto()            -> texto  — decodifica UTF-8 (E0406 si no es válido)
//   .a_hex()              -> texto  — "486f6c61"
//   .a_lista()            -> lista<entero>
//
// ── Métodos de mutación (modifican la instancia) ─────────────────────────
//   .fijar(indice, byte)  .agregar(byte)  .extender(otro)  .limpiar()
//   (extender acepta un Bits o una lista<entero>)
//
// ── Operaciones binarias (devuelven un Bits nuevo) ───────────────────────
//   .y(otro) .o(otro) .oexclusivo(otro) — AND/OR/XOR byte a byte;
//                                         E0406 si las longitudes difieren
//   .negar()                            — NOT byte a byte
//   .desplazar_izquierda(n) / .desplazar_derecha(n)
//      — desplazan los bits de TODO el búfer (longitud constante,
//        se rellena con ceros)
//
// Errores posibles:
//   E0406 — byte fuera de 0-255, índice fuera de rango, hex inválido,
//           longitudes distintas en y/o/oexclusivo, texto no UTF-8
//   E0210 — cantidad incorrecta de argumentos

importar { Bits } desde "quetzal/bits"

// ── Construcción ─────────────────────────────────────────────────────────

Bits sin_datos = nuevo Bits()              // vacío
Bits buffer = nuevo Bits(4)                // [0, 0, 0, 0]
Bits saludo = nuevo Bits("Hola")           // bytes UTF-8: 48 6f 6c 61
Bits primos = nuevo Bits([2, 3, 5, 7])     // desde lista de enteros
Bits firma = Bits.desde_hex("89 50 4e 47") // desde hexadecimal

// Al imprimir, un Bits muestra sus bytes en hexadecimal (recortado a 16).
consola.mostrar(t"Saludo: {saludo}")
consola.mostrar(t"Firma PNG: {firma}")

// ── Consulta y conversiones ──────────────────────────────────────────────

consola.mostrar(t"Longitud del saludo: {saludo.longitud()}")
consola.mostrar(t"Primer byte: {saludo.obtener(0)}")    // 72 ('H')
consola.mostrar(t"Último byte: {saludo.obtener(-1)}")   // 97 ('a')

// rebanada(inicio, fin): sub-búfer desde inicio hasta fin (sin incluirlo).
Bits centro = saludo.rebanada(1, 3)
consola.mostrar(t"Rebanada [1,3): {centro.a_texto()}")  // "ol"

consola.mostrar(t"Como hex: {saludo.a_hex()}")          // 486f6c61
consola.mostrar(t"Como texto: {saludo.a_texto()}")      // Hola
consola.mostrar(t"Como lista: {saludo.a_lista().texto()}")

// ── Mutación ─────────────────────────────────────────────────────────────

Bits var paquete = nuevo Bits()
paquete.agregar(1)              // un byte al final
paquete.extender([2, 3])        // varios bytes (lista o Bits)
paquete.extender(centro)
paquete.fijar(0, 255)           // reemplaza el byte 0
consola.mostrar(t"Paquete armado: {paquete}")
paquete.limpiar()
consola.mostrar(t"Tras limpiar: {paquete.longitud()} bytes")

// ── Operaciones bit a bit ────────────────────────────────────────────────

// Caso de uso: aplicar una máscara para quedarse con el nibble bajo.
Bits datos = nuevo Bits([240, 170, 15])      // f0 aa 0f
Bits mascara = nuevo Bits([15, 15, 15])      // 0f 0f 0f

consola.mostrar(t"AND: {datos.y(mascara).a_hex()}")          // 000a0f
consola.mostrar(t"OR:  {datos.o(mascara).a_hex()}")          // ff af 0f
consola.mostrar(t"XOR: {datos.oexclusivo(mascara).a_hex()}") // ff a5 00
consola.mostrar(t"NOT: {datos.negar().a_hex()}")             // 0f 55 f0

// XOR consigo mismo siempre da ceros (truco clásico de verificación).
Bits ceros = datos.oexclusivo(datos)
consola.mostrar(t"XOR consigo mismo: {ceros.a_hex()}")

// Desplazamientos: corren los bits de todo el búfer como una sola cadena.
Bits unidad = nuevo Bits([0, 1])                       // 00000000 00000001
consola.mostrar(t"<< 4: {unidad.desplazar_izquierda(4).a_hex()}")  // 0010
consola.mostrar(t">> 1: {unidad.desplazar_derecha(1).a_hex()}")    // 0000 (el bit se va)
Bits alto = nuevo Bits([128, 0])                       // 10000000 00000000
consola.mostrar(t"alto >> 9: {alto.desplazar_derecha(9).a_hex()}") // 0040

// ── Manejo de errores ────────────────────────────────────────────────────

// E0406: un byte debe estar entre 0 y 255.
intentar {
    Bits invalido = nuevo Bits([300])
} capturar (excepcion e) {
    consola.mostrar_error(t"Byte inválido: {e.mensaje}")
}

// E0406: hexadecimal mal formado.
intentar {
    Bits roto = Bits.desde_hex("zz")
} capturar (excepcion e) {
    consola.mostrar_error(t"Hex inválido: {e.mensaje}")
}

// E0406: y/o/oexclusivo exigen búferes de la misma longitud.
intentar {
    Bits cruce = datos.y(nuevo Bits(2))
} capturar (excepcion e) {
    consola.mostrar_error(t"Longitudes distintas: {e.mensaje}")
}

// E0406: no todo búfer es texto UTF-8 válido.
intentar {
    texto imposible = firma.a_texto()
} capturar (excepcion e) {
    consola.mostrar_error(t"No es UTF-8: {e.mensaje}")
}

consola.mostrar_informacion("Fin del ejemplo de bits.")
