// Herencia de objetos

// Herencia simple
objeto Animal {
    privado:
        texto var nombre
        texto var especie
    publico:
        Animal(texto nombre, texto especie) {
            esto.nombre = nombre
            esto.especie = especie
        }
        texto obtener_nombre() {
            retornar esto.nombre
        }
        texto obtener_especie() {
            retornar esto.especie
        }

        vacio comer() {
            consola.mostrar("El animal come.")
        }
}

objeto Perro hereda Animal {
    publico:
        Perro(texto nombre, texto especie) {
            padre.Animal(nombre, especie)
        }

        texto ladrar() {
            retornar "Guau!"
        }
}

// Herencia en cascada
objeto Mamifero hereda Animal {
    publico:
        Mamifero(texto nombre, texto especie) {
            padre.Animal(nombre, especie)
        }

        texto comer() {
            retornar "El mamifero come."
        }
}

objeto Gato hereda Mamifero {
    publico:
        Gato(texto nombre, texto especie) {
            padre.Mamifero(nombre, especie)
        }

        texto maullar() {
            retornar "Miau!"
        }
}

// Herencia multiple
objeto Felino hereda Mamifero, Animal {
    publico:
        Felino(texto nombre, texto especie) {
            padre.Mamifero(nombre, especie)
            padre.Animal(nombre, especie)
        }

        texto comer() {
            retornar padre.Mamifero.comer()
        }

        texto rugir() {
            retornar "Rugido!"
        }
}

// Instanciar objetos
Perro perro1 = nuevo Perro("Firulais", "Canino")
Gato gato1 = nuevo Gato("Michi", "Felino")
Felino felino1 = nuevo Felino("Simba", "Felino")

// Llamar a métodos
texto nombre_perro = perro1.obtener_nombre()  // "Firulais"
texto nombre_gato = gato1.obtener_nombre()  // "Michi"
texto nombre_felino = felino1.obtener_nombre()  // "Simba"

texto sonido_perro = perro1.ladrar()  // "Guau!"
texto sonido_gato = gato1.maullar()  // "Miau!"
texto sonido_felino = felino1.rugir()  // "Rugido!"

// Llamar a métodos de la clase padre
texto especie_perro = perro1.obtener_especie()  // "Canino"

consola.mostrar(nombre_perro)
consola.mostrar(nombre_gato)
consola.mostrar(nombre_felino)
consola.mostrar(sonido_perro)
consola.mostrar(sonido_gato)
consola.mostrar(sonido_felino)
consola.mostrar(especie_perro)

// Llamar a métodos de la clase padre
texto especie_gato = gato1.obtener_especie()  // "Felino"
consola.mostrar(especie_gato)