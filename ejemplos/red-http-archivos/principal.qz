// ============================================================================
// red-http-archivos: streaming de archivos y respuestas por trozos
// ============================================================================
//
// Extiende 'red-http-servidor' con tres formas de servir contenido binario o
// generado sobre la marcha sin materializar el cuerpo completo en memoria:
//
//   1. ServidorHttp.estaticos(prefijo, directorio): carpeta estática servida
//      automáticamente (HTML, imágenes, texto...).
//   2. Respuestas.archivo(ruta): sirve un archivo explícito, con soporte de
//      'Range' (streaming en video/audio, "byte range" en inglés) y caché
//      condicional ('ETag'/'Last-Modified', "entity tag" en inglés).
//   3. Respuestas.flujo(generador): respuesta por trozos ("chunked" en
//      inglés) para *server-sent events* (SSE) u otro contenido incremental.
//
// Este proyecto usa rutas relativas ("publico/...") para el sistema de
// archivos, así que hay que ejecutarlo con el directorio del proyecto como
// directorio actual (donde vive este 'quetzal.json'):
//   cd ejemplos/red-http-archivos
//   quetzal ejecutar .
//
// Pruébalo con curl (en otra terminal, mientras este script sigue corriendo):
//   curl http://127.0.0.1:8080/publico/indice.html
//   curl http://127.0.0.1:8080/publico/quetzal.svg
//   curl -r 0-19 -i http://127.0.0.1:8080/publico/notas.txt   (ve el 206)
//   curl -i http://127.0.0.1:8080/notas                       (ve ETag/304)
//   curl -N http://127.0.0.1:8080/eventos                     (ve el SSE)
//
// Requiere en quetzal.json:
//   "red": { "habilitado": true, "servidor": true }
//   "sistema_archivos": { "habilitado": true,
//                          "directorios": [{"ruta": "./publico", "permiso": "lectura"}] }

// ServidorHttp y las piezas para construir peticiones/respuestas, igual que
// en 'red-http-servidor'.
importar { ServidorHttp, PeticionHttp, RespuestaServidor, Respuestas } desde "quetzal/red"

ServidorHttp servidor = nuevo ServidorHttp() // instancia sin rutas ni puerto todavía

// ── 1. Carpeta estática ──────────────────────────────────────────────────
//
// Cualquier petición GET que empiece con "/publico" y no coincida con una
// ruta explícita se resuelve buscando el archivo dentro de "publico/" (aquí,
// relativo a la raíz del proyecto). El propio motor protege contra "path
// traversal" (que alguien pida "/publico/../secreto.txt"): si la ruta
// resuelta queda fuera del directorio, responde 404 en vez de filtrar
// archivos. Reutiliza todo el camino de 'Respuestas.archivo': MIME
// automático, Range, ETag/Last-Modified.
servidor.estaticos("/publico", "publico")

// ── 2. Archivo explícito, con caché personalizada ────────────────────────
//
// Además de servirse como estático bajo "/publico/notas.txt", el mismo
// archivo se expone a mano bajo "/notas" para mostrar 'Respuestas.archivo'
// como pieza suelta: aquí se le puede agregar cualquier cabecera propia
// (por ejemplo, un 'Cache-Control' que el modo estático no pone).
RespuestaServidor manejar_notas(PeticionHttp peticion) {
    RespuestaServidor respuesta = Respuestas.archivo("publico/notas.txt")
    respuesta.fijar_cabecera("Cache-Control", "public, max-age=60")
    retornar respuesta
}

// ── 3. Server-sent events con Respuestas.flujo ───────────────────────────
//
// Quetzal no soporta funciones anidadas (declaradas dentro de otra función),
// así que el generador 'siguiente_evento' y su contador viven a nivel de
// módulo: cada llamada al generador avanza el mismo contador, sin importar
// qué petición lo disparó (para aislar el estado por cliente conectado
// haría falta guardarlo en un 'jsn'/lista indexado por algún identificador
// de conexión).
entero var contador_eventos = 0

// El generador se invoca una vez por cada trozo que se manda al cliente.
// Debe devolver 'texto' (o Bits) con el siguiente trozo, o 'nulo' para
// cerrar el flujo. El formato "data: ...\n\n" es el que exige SSE: cada
// línea que empieza con "data:" es un evento, y la línea vacía lo cierra.
texto siguiente_evento() {
    contador_eventos = contador_eventos + 1
    si (contador_eventos > 5) {
        retornar nulo // fin del flujo: el motor manda el trozo terminal y cierra
    }
    retornar t"data: evento número {contador_eventos}\n\n"
}

RespuestaServidor manejar_eventos(PeticionHttp peticion) {
    RespuestaServidor respuesta = Respuestas.flujo(siguiente_evento)
    respuesta.fijar_cabecera("Content-Type", "text/event-stream")
    respuesta.fijar_cabecera("Cache-Control", "no-cache")
    retornar respuesta
}

servidor.obtener("/notas", manejar_notas)
servidor.obtener("/eventos", manejar_eventos)
servidor.escuchar(8080)

consola.mostrar_informacion(t"Servidor HTTP escuchando en 127.0.0.1:{servidor.puerto()}")
consola.mostrar_informacion("Ctrl+C para detenerlo. Pruébalo desde otra terminal con:")
consola.mostrar("  curl http://127.0.0.1:8080/publico/indice.html")
consola.mostrar("  curl -r 0-19 -i http://127.0.0.1:8080/publico/notas.txt")
consola.mostrar("  curl -i http://127.0.0.1:8080/notas")
consola.mostrar("  curl -N http://127.0.0.1:8080/eventos")

// El motor mantiene vivo el bucle de eventos después de aquí (como el event
// loop de Node.js) mientras 'servidor' siga escuchando: este script nunca
// llama a 'servidor.detener()', así que sigue atendiendo peticiones hasta
// que se cancele manualmente (Ctrl+C).
