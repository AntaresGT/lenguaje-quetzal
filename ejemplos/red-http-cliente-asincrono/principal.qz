// ============================================================================
// red-http-cliente-asincrono: ClienteHttp con '_asincrono' + 'esperar'
// ============================================================================
//
// A diferencia de 'red-http-cliente-sincrono', este ejemplo NO necesita otro
// proceso: monta su propio ServidorHttp y se golpea a sí mismo, en el mismo
// script, sin bloquearse. Ejecútalo solo:
//   quetzal ejecutar ejemplos/red-http-cliente-asincrono
//
// ¿Por qué es seguro golpearse a sí mismo aquí y no con el cliente síncrono?
// 'esperar cliente.obtener_asincrono(...)' bombea el bucle de eventos
// mientras espera la respuesta: si en ese momento llega la petición a este
// mismo servidor, su manejador puede ejecutarse sin problema (el hilo de la
// conexión, por su parte, espera bloqueado esa respuesta antes de escribirla
// en el socket, así que al terminar 'esperar' el manejador ya corrió,
// siempre). El método síncrono ('obtener', sin 'esperar') no bombea nada:
// bloquearía el hilo de la VM y jamás dejaría correr al manejador.
//
// Requiere en quetzal.json:
//   "red": { "habilitado": true, "cliente": true, "servidor": true }

// Cliente HTTP y el tipo de su respuesta (.estado()/.texto()/.jsn()/.bits()).
importar { ClienteHttp, RespuestaHttp } desde "quetzal/red"
// Servidor HTTP, la petición que recibe cada ruta y cómo construir una
// respuesta con código de estado propio (RespuestaServidor/Respuestas.crear).
importar { ServidorHttp, PeticionHttp, RespuestaServidor, Respuestas } desde "quetzal/red"
// Bits: para enviar/leer el cuerpo binario del POST /eco.
importar { Bits } desde "quetzal/bits"

entero var aciertos = 0 // contador global de comprobaciones que pasaron
entero var fallos = 0   // contador global de comprobaciones que fallaron

// Reporta una comprobación y la cuenta para el resumen final.
vacio verificar(log condicion, texto descripcion) {
    si (condicion) {
        aciertos = aciertos + 1
        consola.mostrar(t"  [OK] {descripcion}")
    } sino {
        fallos = fallos + 1
        consola.mostrar_error(t"  [FALLO] {descripcion}")
    }
}

ServidorHttp servidor = nuevo ServidorHttp() // instancia sin rutas ni puerto todavía

// Manejador de "GET /": ignora la petición y siempre devuelve el mismo texto.
texto manejar_inicio(PeticionHttp peticion) {
    retornar "hola desde Quetzal"
}

// Manejador de "GET /saludo/:nombre": lee el parámetro de ruta y responde jsn.
jsn manejar_saludo(PeticionHttp peticion) {
    jsn parametros = peticion.parametros()
    retornar { saludo: t"hola, {parametros.nombre}!" }
}

// Manejador de "POST /eco": eco binario con estado 200 explícito.
RespuestaServidor manejar_eco(PeticionHttp peticion) {
    Bits cuerpo = peticion.bits()
    retornar Respuestas.crear(200, cuerpo)
}

// Manejador de "GET /nada": responde 404 a propósito (código personalizado).
RespuestaServidor manejar_ruta_personalizada(PeticionHttp peticion) {
    retornar Respuestas.crear(404, "aquí no hay nada")
}

servidor.obtener("/", manejar_inicio)                // registra GET / -> manejar_inicio (por referencia)
servidor.obtener("/saludo/:nombre", manejar_saludo)   // registra GET /saludo/:nombre -> manejar_saludo
servidor.publicar("/eco", manejar_eco)                // registra POST /eco -> manejar_eco
servidor.obtener("/nada", manejar_ruta_personalizada) // registra GET /nada -> manejar_ruta_personalizada
servidor.escuchar(0)                                  // puerto 0 = que el sistema elija uno libre
entero puerto = servidor.puerto()                     // puerto real que quedó asignado
consola.mostrar(t"Servidor HTTP escuchando en 127.0.0.1:{puerto}")

ClienteHttp cliente = nuevo ClienteHttp() // cliente reutilizable para las 5 peticiones siguientes

// GET / asincrónico: 'esperar' bombea el bucle de eventos hasta la respuesta.
RespuestaHttp r1 = esperar cliente.obtener_asincrono(t"http://127.0.0.1:{puerto}/")
verificar(r1.estado() == 200 && r1.texto() == "hola desde Quetzal", "GET / responde el texto esperado")

// GET /saludo/quetzal: verifica que ':nombre' se capturó bien como "quetzal".
RespuestaHttp r2 = esperar cliente.obtener_asincrono(t"http://127.0.0.1:{puerto}/saludo/quetzal")
jsn cuerpo_r2 = r2.jsn() // decodifica el cuerpo jsn de la respuesta
verificar(cuerpo_r2.saludo == "hola, quetzal!", "GET /saludo/:nombre extrae el parámetro de ruta")

// POST /eco con cuerpo binario: confirma que el Bits enviado vuelve intacto.
Bits datos_enviados = Bits.desde_hex("48656c6c6f") // "Hello" en hexadecimal
RespuestaHttp r3 = esperar cliente.publicar_asincrono(t"http://127.0.0.1:{puerto}/eco", datos_enviados)
verificar(r3.bits().a_hex() == "48656c6c6f", "POST /eco (asincrónico) devuelve el mismo binario enviado")

// GET /nada: la RespuestaServidor del manejador debe mandar el 404 explícito.
RespuestaHttp r4 = esperar cliente.obtener_asincrono(t"http://127.0.0.1:{puerto}/nada")
verificar(r4.estado() == 404, "una RespuestaServidor personalizada respeta el código de estado")

// GET /no-existe: ninguna ruta coincide, así que el servidor responde 404 solo.
RespuestaHttp r5 = esperar cliente.obtener_asincrono(t"http://127.0.0.1:{puerto}/no-existe")
verificar(r5.estado() == 404, "una ruta sin manejador responde 404 automáticamente")

servidor.detener() // ya no hace falta seguir escuchando; el script puede terminar

consola.mostrar_informacion(t"Resumen: {aciertos} de {aciertos + fallos} comprobaciones exitosas.")
