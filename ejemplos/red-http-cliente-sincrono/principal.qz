// ============================================================================
// red-http-cliente-sincrono: ClienteHttp con métodos bloqueantes
// ============================================================================
//
// Ejecuta primero 'red-http-servidor' (deja un ServidorHttp en el puerto
// 8080) y luego, en otra terminal, este archivo:
//   quetzal ejecutar ejemplos/red-http-cliente-sincrono
//
// IMPORTANTE: 'obtener'/'publicar' (sin '_asincrono') BLOQUEAN el hilo de la
// VM hasta que llega la respuesta completa. Por eso este cliente golpea a un
// servidor de OTRO proceso: si intentaras usarlos contra un ServidorHttp del
// MISMO script, el hilo de la VM quedaría atrapado dentro de la petición y
// jamás podría atender la conexión entrante para ejecutar el manejador de la
// ruta (compáralo con 'red-http-cliente-asincrono', que sí puede golpearse a
// sí mismo porque 'esperar' bombea el bucle de eventos mientras espera).

// Cliente HTTP y el tipo de su respuesta (.estado()/.texto()/.jsn()/.bits()).
importar { ClienteHttp, RespuestaHttp } desde "quetzal/red"
// Bits: para enviar/leer el cuerpo binario del POST /eco.
importar { Bits } desde "quetzal/bits"

ClienteHttp cliente = nuevo ClienteHttp() // cliente reutilizable para las 3 peticiones siguientes

// GET / bloqueante: el script se detiene aquí hasta que llega la respuesta.
RespuestaHttp r1 = cliente.obtener("http://127.0.0.1:8080/")
consola.mostrar(t"GET / -> {r1.estado()}: {r1.texto()}")

// GET /saludo/quetzal: el servidor devuelve un jsn con el parámetro capturado.
RespuestaHttp r2 = cliente.obtener("http://127.0.0.1:8080/saludo/quetzal")
jsn cuerpo_r2 = r2.jsn() // decodifica el cuerpo jsn de la respuesta
consola.mostrar(t"GET /saludo/quetzal -> {cuerpo_r2.saludo}")

// POST /eco con cuerpo binario: el servidor devuelve el mismo Bits enviado.
Bits datos_enviados = Bits.desde_hex("48656c6c6f") // "Hello" en hexadecimal
RespuestaHttp r3 = cliente.publicar("http://127.0.0.1:8080/eco", datos_enviados)
consola.mostrar(t"POST /eco -> {r3.estado()}: {r3.bits().a_hex()}")

si (r1.estado() == 200 && cuerpo_r2.saludo == "hola, quetzal!" && r3.bits().a_hex() == "48656c6c6f") {
    consola.mostrar_informacion("Cliente HTTP síncrono: verificación exitosa.")
} sino {
    consola.mostrar_error("Cliente HTTP síncrono: alguna respuesta no coincide con lo esperado.")
}
