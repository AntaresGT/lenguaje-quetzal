// ============================================================================
// red-http-servidor: ServidorHttp con rutas en español
// ============================================================================
//
// Deja un ServidorHttp escuchando en el puerto fijo 8080. Pruébalo con
// 'red-http-cliente-sincrono' o 'red-http-cliente-asincrono' (en otra
// terminal), o directamente con curl:
//   curl http://127.0.0.1:8080/
//   curl http://127.0.0.1:8080/saludo/quetzal
//   curl -X POST --data-binary "hola" http://127.0.0.1:8080/eco
//
// Requiere en quetzal.json: "red": { "habilitado": true, "servidor": true }

// Servidor HTTP, la petición que recibe cada ruta y cómo construir una
// respuesta con código de estado propio (RespuestaServidor/Respuestas.crear).
importar { ServidorHttp, PeticionHttp, RespuestaServidor, Respuestas } desde "quetzal/red"
// Bits: para leer/escribir el cuerpo de una petición u respuesta en binario.
importar { Bits } desde "quetzal/bits"

ServidorHttp servidor = nuevo ServidorHttp() // instancia sin rutas ni puerto todavía

// Manejador de "GET /": ignora la petición y siempre devuelve el mismo texto.
// Devolver 'texto' directo implica 200 OK con Content-Type text/plain.
texto manejar_inicio(PeticionHttp peticion) {
    retornar "hola desde Quetzal"
}

// Manejador de "GET /saludo/:nombre": lee el parámetro de ruta ':nombre' y
// devuelve un 'jsn' (se serializa solo, con Content-Type application/json).
jsn manejar_saludo(PeticionHttp peticion) {
    jsn parametros = peticion.parametros()              // {nombre: "..."} capturado de la ruta
    retornar { saludo: t"hola, {parametros.nombre}!" }   // cuerpo jsn de la respuesta
}

// Manejador de "POST /eco": lee el cuerpo de la petición como Bits (binario)
// y lo devuelve intacto, envuelto en una RespuestaServidor con estado 200.
RespuestaServidor manejar_eco(PeticionHttp peticion) {
    Bits cuerpo = peticion.bits()          // bytes crudos enviados en el POST
    retornar Respuestas.crear(200, cuerpo) // eco binario con estado explícito
}

// Manejador de "GET /nada": muestra que un manejador puede fijar cualquier
// código de estado (aquí 404) usando Respuestas.crear en vez del 200 implícito.
RespuestaServidor manejar_ruta_personalizada(PeticionHttp peticion) {
    retornar Respuestas.crear(404, "aquí no hay nada")
}

servidor.obtener("/", manejar_inicio)                // registra GET / -> manejar_inicio (por referencia)
servidor.obtener("/saludo/:nombre", manejar_saludo)   // registra GET /saludo/:nombre -> manejar_saludo
servidor.publicar("/eco", manejar_eco)                // registra POST /eco -> manejar_eco
servidor.obtener("/nada", manejar_ruta_personalizada) // registra GET /nada -> manejar_ruta_personalizada
servidor.escuchar(8080)                               // abre el socket en el puerto fijo 8080

consola.mostrar_informacion(t"Servidor HTTP escuchando en 127.0.0.1:{servidor.puerto()}")
consola.mostrar_informacion("Ctrl+C para detenerlo. Pruébalo desde otra terminal con:")
consola.mostrar("  quetzal ejecutar ejemplos/red-http-cliente-sincrono")
consola.mostrar("  quetzal ejecutar ejemplos/red-http-cliente-asincrono")

// El motor mantiene vivo el bucle de eventos después de aquí (como el event
// loop de Node.js) mientras 'servidor' siga escuchando: este script nunca
// llama a 'servidor.detener()', así que sigue atendiendo peticiones hasta
// que se cancele manualmente (Ctrl+C).
