// ============================================================================
// red-udp-asincrono: SocketUdp con 'recibir_asincrono()' + 'esperar'
// ============================================================================
//
// Ejecútalo solo, no necesita otro proceso:
//   quetzal ejecutar ejemplos/red-udp-asincrono
//
// Igual que 'red-udp-sincrono', pero 'recibir_asincrono()' devuelve una
// tarea nativa que se resuelve con 'esperar': mientras se espera el
// datagrama, el bucle de eventos sigue bombeado y no se bloquea el hilo de
// la VM (útil si mientras tanto tu programa necesita seguir atendiendo otra
// cosa, por ejemplo un ServidorHttp en el mismo proceso).
//
// Requiere en quetzal.json:
//   "red": { "habilitado": true, "cliente": true, "servidor": true }

// SocketUdp: un solo tipo hace de emisor y de receptor (no hay conexión).
importar { SocketUdp } desde "quetzal/red"
// Bits: los datagramas siempre llegan como binario, sin importar qué se envió.
importar { Bits } desde "quetzal/bits"

SocketUdp receptor = nuevo SocketUdp() // socket que va a recibir los datagramas
receptor.enlazar(0)                    // se enlaza a un puerto libre elegido por el sistema
entero puerto = receptor.puerto()      // puerto real donde quedó enlazado
SocketUdp emisor = nuevo SocketUdp()   // socket que va a enviar (se autoenlaza al enviar)

emisor.enviar_a("127.0.0.1", puerto, "hola udp asincrono")     // envía un datagrama de texto
jsn datagrama = esperar receptor.recibir_asincrono()            // espera sin bloquear el hilo de la VM
Bits datos = datagrama.datos                                    // campo 'datos': los bytes recibidos (Bits)
texto mensaje = datos.a_texto()                                 // decodifica a texto
consola.mostrar(t"Recibido de {datagrama.origen}:{datagrama.puerto} -> {mensaje}")

receptor.cerrar() // libera el socket receptor
emisor.cerrar()   // libera el socket emisor

si (mensaje == "hola udp asincrono") {
    consola.mostrar_informacion("UDP asincrónico: verificación exitosa.")
} sino {
    consola.mostrar_error("UDP asincrónico: el datagrama no coincide con lo esperado.")
}
