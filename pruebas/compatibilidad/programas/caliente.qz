entero sumar_hasta(entero limite) {
    entero var suma = 0
    para (entero var i = 0; i < limite; i++) {
        suma += i
    }
    retornar suma
}
entero a = sumar_hasta(250)
entero b = sumar_hasta(250)
entero c = sumar_hasta(250)
entero d = sumar_hasta(250)
entero resultado = sumar_hasta(2000000)
consola.mostrar(resultado)
